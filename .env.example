# Owner key used to sign and verify infra/allowlist.json (R0). Empty = documented demo key.
ALLOWLIST_KEY=
# 1 = scripted explanations (default). 0 + ANTHROPIC_API_KEY = real model for explain/answer only.
MOCK=1
# Anthropic Messages API key; the model only writes text, never scores or edits.
ANTHROPIC_API_KEY=
# Model id used when MOCK=0.
LLM_MODEL=claude-sonnet-5-5
# 1 + FACTORY_API_KEY = Factory Droid writes fix PRs on a scratch copy (R2).
DROID=
# Factory API key for droid-sdk.
FACTORY_API_KEY=
# Comma-separated rules Droid handles; others use local fixers.
DROID_RULES=WEB_DEFAULT_CREDS,PROXY_CATCH_ALL,REDIS_NO_AUTH,DOTENV_SERVED
# 1 = ignore out/droid-cache and re-run Droid every time.
DROID_NOCACHE=
# Moss hosted memory; both set = MossMemory, else keyword index.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Moss index name.
MOSS_INDEX=portcullis
# Lab bind address for the stub services.
LAB_BIND=127.0.0.1
# 1 = pr.py pushes a branch and runs gh pr create (production only).
GH_PUSH=
# ntfy/webhook URL that receives one line per new P1 (production only).
ALERT_URL=
